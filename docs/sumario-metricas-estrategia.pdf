0.122 0.161 0.216 rg
65.1968503937007995 139.6348818897637329 Td
(// calculateLeadTimeJornada\(\) - mappers.ts) Tj
T* (// Apenas Epics CONCLUIDOS \(status 10019\)) Tj
T* (for each Epic concluido:) Tj
T* (  changelog = epicChangelogs[epic.key]) Tj
T* (  sorted = changelog.sort\(created ASC\)) Tj
T* () Tj
T* (  // Encontra data de conclusao) Tj
T* (  fimCiclo = Date.now\(\) // fallback) Tj
T* (  for each entry in sorted:) Tj
T* (    for each item in entry.items:) Tj
T* (      if item.field === 'status') Tj
T* (         AND item.toString === '10019':) Tj
T* (        fimCiclo = entry.created) Tj
T* () Tj
T* (  totalDias = \(fimCiclo - criadoEm\)) Tj
T* (    / \(1000*60*60*24\)) Tj
T* (  lifecycleTotals.push\(totalDias\)) Tj
T* () Tj
T* (  // Rastreia bloqueios) Tj
T* (  bloqueioInicio = null) Tj
T* (  blockedDias = 0) Tj
T* (  for each entry in sorted:) Tj
T* (    for each item in entry.items:) Tj
T* (      if item.fieldId === 'customfield_13406':) Tj
T* (        if estavaVazio AND ficouPreenchido:) Tj
T* (          bloqueioInicio = entry.created) Tj
T* (        if estavaPreenchido AND ficouVazio:) Tj
T* (          blockedDias += \(entry.created) Tj
T* (            - bloqueioInicio\) / \(1000*60*60*24\)) Tj
T* (          bloqueioInicio = null) Tj
T* () Tj
T* (  // Se ainda bloqueado no fim) Tj
T* (  if bloqueioInicio !== null:) Tj
T* (    blockedDias += \(fimCiclo - bloqueioInicio\)) Tj
T* (      / \(1000*60*60*24\)) Tj
T* (  blockedTotals.push\(blockedDias\)) Tj
T* () Tj
T* (// Medias finais:) Tj
T* (blockedTimeDias = SUM\(blockedTotals\)) Tj
T* (  / blockedTotals.length) Tj
T* (mediaTotalDias = SUM\(lifecycleTotals\)) Tj
T* (  / lifecycleTotals.length) Tj
T* (blockedTimePct = \(blockedTimeDias) Tj
T* (  / mediaTotalDias\) * 100) Tj
ET
endstream
