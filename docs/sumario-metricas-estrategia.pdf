(// calculateCycleTimeExperimentacaoDetalhado\(\)) Tj
T* (PORTE_MAP = {) Tj
T* (  'Baixa': 'P', 'Media': 'M', 'Alta': 'G',) Tj
T* (  'P': 'P', 'M': 'M', 'G': 'G') Tj
T* (}) Tj
T* () Tj
T* (for each Epic concluido:) Tj
T* (  cycleTime = calcularCycleTime\(epic\)) Tj
T* (  complexidadeRaw = epic.fields.customfield_30358) Tj
T* (  porte = PORTE_MAP[complexidadeRaw] ?? 'Sem porte') Tj
T* (  porteCycleTimes[porte].push\(cycleTime\)) Tj
T* () Tj
T* (// Para cada porte:) Tj
T* (media = SUM\(dias\) / count) Tj
T* (mediana = valor do meio do array ordenado) Tj
T* (blockedTimeMedio = SUM\(dias bloqueados\) / count) Tj
T* () Tj
T* (// Ordem: P \(Baixa\) -> M \(Media\) -> G \(Alta\)) Tj
ET
