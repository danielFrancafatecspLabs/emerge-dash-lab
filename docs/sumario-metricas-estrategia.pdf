(// calculateCycleTimeExperimentacaoDetalhado\(\)) Tj
T* (// Apenas Epics CONCLUIDOS \(status 10019\)) Tj
T* (EXPERIMENTACAO_NAMES = {) Tj
T* (  'Em andamento', 'In Progress', 'EM VALIDACAO') Tj
T* (}) Tj
T* () Tj
T* (for each Epic concluido:) Tj
T* (  changelog = epicChangelogs[epic.key]) Tj
T* (  sorted = changelog.sort\(created ASC\)) Tj
T* () Tj
T* (  // Encontra periodos em experimentacao) Tj
T* (  periodos = []) Tj
T* (  entrouEm = null) Tj
T* (  for each entry in sorted:) Tj
T* (    for each item in entry.items:) Tj
T* (      if item.field === 'status':) Tj
T* (        if item.toString in EXPERIMENTACAO_NAMES) Tj
T* (           AND item.fromString NOT in:) Tj
T* (          entrouEm = entry.created) Tj
T* (        if item.fromString in EXPERIMENTACAO_NAMES) Tj
T* (           AND item.toString NOT in:) Tj
T* (          periodos.push\({) Tj
T* (            inicio: entrouEm,) Tj
T* (            fim: entry.created) Tj
T* (          }\)) Tj
T* (          entrouEm = null) Tj
T* () Tj
T* (  // Subtrai periodos bloqueados) Tj
T* (  bloqueios = getPeriodosBloqueio\(epic.key\)) Tj
T* (  cycleTime = subtrairBloqueios\(periodos, bloqueios\)) Tj
T* () Tj
T* (// Media final:) Tj
T* (cycleTimeGeral = SUM\(cycleTime\) / qtdEpics) Tj
ET
endstream
