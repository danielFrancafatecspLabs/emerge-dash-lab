(// Em buildDashboardData\(\) - mappers.ts) Tj
T* (epicsComBeneficio = allEpicDetails) Tj
T* (  .filter\(e => \(e.beneficioQuantitativo ?? 0\) > 0\)) Tj
T* (beneficioTotal = epicsComBeneficio) Tj
T* (  .reduce\(\(s, e\) => s + \(e.beneficioQuantitativo ?? 0\), 0\)) Tj
T* (beneficioMedio = epicsComBeneficio.length > 0) Tj
T* (  ? beneficioTotal / epicsComBeneficio.length) Tj
T* (  : 0) Tj
T* () Tj
T* (// Fonte: customfield_30216 \(campo "Beneficio Quantitativo"\)) Tj
T* (// Preenchido manualmente pelo usuario ao cadastrar o experimento) Tj
ET
