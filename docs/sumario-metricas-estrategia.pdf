(// Em buildDashboardData\(\) - mappers.ts) Tj
T* (SEGMENTOS = ['Consumo', 'Corporativo', 'PME/GE/GOV']) Tj
T* (segMap = new Map\(SEGMENTOS.map\(s => [s, []]\)\)) Tj
T* () Tj
T* (for each EpicDetail e:) Tj
T* (  seg = segmentoClassification[e.key]) Tj
T* (    ?? getSegmentoFallback\(dominioByKey.get\(e.key\)\)) Tj
T* (  segMap.get\(seg\).push\(e\)) Tj
T* () Tj
T* (for each segmento:) Tj
T* (  qtdExperimentos = epics.length) Tj
T* (  valorPotencial = SUM\(e.beneficioQuantitativo ?? 0\)) Tj
T* (  dominios = top 4 dominios mais frequentes) Tj
T* (    pct = \(count / total\) * 100) Tj
T* (  alertas:) Tj
T* (    bloqueadosIA = epics with motivoBloqueio) Tj
T* (    aguardandoDelivery = epics status 10067) Tj
T* (    semSponsor = epics without sponsor) Tj
