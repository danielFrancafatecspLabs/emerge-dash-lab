(// Em EstrategiaClient.tsx - filtrarDashboardData\(\)) Tj
T* (// 1. Filtra iniciativas por criadoEm) Tj
T* (iniciativasFiltradas = iniciativas) Tj
T* (  .filter\(ini => isDataNoPeriodo\(ini.criadoEm, periodo\)\)) Tj
T* () Tj
T* (// 2. Para cada iniciativa, filtra seus Epics) Tj
T* (ini.epics = ini.epics) Tj
T* (  .filter\(epic => isDataNoPeriodo\(epic.criadoEm, periodo\)\)) Tj
T* () Tj
T* (// 3. Recalcula beneficioQuantitativoTotal) Tj
T* (ini.beneficioQuantitativoTotal = SUM\() Tj
T* (  epicsFiltrados.beneficioQuantitativo\)) Tj
T* () Tj
T* (// 4. Reagrega dominios, sponsors, segmentos) Tj
T* (ini.dominios = Array.from\(new Set\() Tj
T* (  epicsFiltrados.map\(e => e.dominio\)\)\)) Tj
T* (ini.sponsors = Array.from\(new Set\() Tj
T* (  epicsFiltrados.map\(e => e.sponsor\)\)\)) Tj
T* () Tj
T* (// 5. Recalcula pipeline \(contagem por coluna\)) Tj
T* (// 6. Recalcula beneficioTotal, beneficioMedio) Tj
T* (// 7. Recalcula mercados, mercadosSegmento,) Tj
T* (//    top5Epics, topSponsors) Tj
T* (// 8. Recalcula statusDistribuicao \(donut\),) Tj
T* (//    metasAgregadas, iniciativasPorMeta) Tj
T* () Tj
T* (// Opcoes de periodo:) Tj
T* (// 'tudo' | 'ultimos12' | 'ultimos6') Tj
T* (// | 'ultimos3' | 'ultimoMes' | personalizado) Tj
