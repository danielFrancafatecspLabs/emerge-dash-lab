(// Algoritmo simplificado de buildMonitoramentoData\(\)) Tj
T* (// Para cada mes desde a data mais antiga ate hoje:) Tj
T* (for each mes:) Tj
T* (  realizado[mes] = COUNT de Epics com status 10003) Tj
T* (    E concluidoEm <= fim do mes) Tj
T* (  beneficio[mes] = SUM\(beneficioQuantitativo\)) Tj
T* (    desses Epics) Tj
T* () Tj
T* (// Acumulado: cada mes soma o valor do mes anterior) Tj
T* (// Ex: Jan=2, Fev=3, Mar=1 -> acum: Jan=2, Fev=5, Mar=6) Tj
T* () Tj
T* (// Metricas derivadas:) Tj
T* (experimentosConcluidos = total Epics status 10003) Tj
T* (taxaConversao = experimentosConcluidos) Tj
T* (  / total experimentos * 100) Tj
ET
