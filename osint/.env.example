# =====================================================================
# Signal Strategic Dashboard - Environment Configuration
# =====================================================================

# GEMINI_API_KEY: Required for live LLM features (Executive OSINT Briefings & Signal Dossier Tactical Assessments).
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If omitted or left empty, the application runs in offline mode without AI features.
GEMINI_API_KEY=

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: production or development
NODE_ENV=production

# APP_URL: Base URL where the app is hosted (default: http://localhost:3000)
APP_URL="http://localhost:3000"
