# Copie para .env.local e preencha. Nunca versione o arquivo com valores reais.

# ── Autenticação ─────────────────────────────────────────────────────────────
# Segredo que assina o cookie de sessão (HMAC). Gere com: openssl rand -base64 48
AUTH_SECRET=

# ── Jira (dados do dashboard) ────────────────────────────────────────────────
JIRA_BASE_URL=https://clarobr-jsw-tecnologia.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BOARD_IDEACAO_ID=2734        # Iniciativas
JIRA_BOARD_INICIATIVAS_ID=2735    # Experimentos (Epics)
# O Jira é lido uma vez por dia (horário de Brasília) e a leitura fica guardada no servidor; ver README, "Cache dos dados do Jira".
# JIRA_CACHE_DIR=.cache            # onde o último snapshot fica gravado (sobrevive a reinícios)

# ── IA ───────────────────────────────────────────────────────────────────────
# Azure OpenAI: Cientista do painel, insights da Estratégia e imagens do Report
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
# Proxy LiteLLM: classificação de portfólio e segmento
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TLS_VERIFY=1                # exige certificado TLS válido do proxy (padrão: não verifica, como sempre foi)

# ── Login ────────────────────────────────────────────────────────────────────
# Foto do login (padrão: public/login-fundo.jpg). Ex.: /jira/foto-time.jpg
# NEXT_PUBLIC_LOGIN_PHOTO_URL=

# ── Comunidade ───────────────────────────────────────────────────────────────
# Backend do Cientista (projeto cientista-lab / METAEXP)
CIENTISTA_API_URL=
# Acervo de pesquisas (clone local do repositório de pesquisas)
RESEARCH_VAULT_PATH=

# ── Arquivos de dados (opcional; padrão: ./data/<arquivo>.json) ──────────────
# USERS_FILE_PATH=
# BENEFICIOS_FILE_PATH=
# POSTS_FILE_PATH=
# COMMUNITY_PROFILES_PATH=
# COMMUNITY_MESSAGES_PATH=
# CHAT_PRESENCE_PATH=
# STORIES_FILE_PATH=

# ── Radar OSINT ──────────────────────────────────────────────────────────────
# Versão do app publicada por ops/osint-app-deploy.sh (ver ops/README-osint-app.md). Sem ela, vale osint/bundle.
# OSINT_APP_DIR=/home/azureuser/osint-app-current

# ── Newsletter (beOn Radar) ──────────────────────────────────────────────────
# Feeds RSS/Atom varridos todo dia (opcional; sem ela, usa a lista padrão de src/lib/newsletter/edicao.ts).
# O servidor precisa de acesso de saída a esses sites. Formato: Nome|https://…,Outro|https://…
# NEWSLETTER_FEEDS=
# As notícias da edição viram discussões no fórum (conta "beOn Radar - Newsletter"), cada uma com uma provocação.
# Quantas por seção da edição (padrão 3, ou seja, até 12 por dia; 0 desliga).
# RADAR_DISCUSSOES_POR_SECAO=3
# Com LLM_API_KEY/LLM_API_BASE configurados, o LLM escreve a provocação de cada matéria; 0 usa só os modelos por tema.
# RADAR_PROVOCACAO_LLM=1
# Cotações da faixa e da régua do beOn Radar (Yahoo Finance, sem chave, renovadas a cada minuto no servidor).
# Cesta própria: SIMBOLO|Nome|grupo (grupos: indice, big-tech, chips, telecom, cripto).
# RADAR_COTACOES=NVDA|Nvidia|chips,^BVSP|Ibovespa|indice
# Pesquisa em IA (seção da newsletter): papers do arXiv, Daily Papers do Hugging Face e fotos da Wikipedia, sem chave,
# lidos no máximo a cada 6 horas. O servidor precisa de acesso de saída a export.arxiv.org, huggingface.co e
# en.wikipedia.org e upload.wikimedia.org (o app guarda as fotos e as serve ele mesmo). As URLs abaixo só servem para testes.
# RADAR_ARXIV_BASE_URL=https://export.arxiv.org
# RADAR_HUGGINGFACE_BASE_URL=https://huggingface.co
# RADAR_WIKIPEDIA_BASE_URL=https://en.wikipedia.org
# Histórico do mês (top 10 pelo Índice de Impacto); padrão data/newsletter-historico.json.
# NEWSLETTER_HISTORICO_PATH=
# Push do beOn Radar (Web Push). Sem as chaves, o app gera um par e guarda em data/vapid.json na primeira vez.
# O push do navegador só funciona com o site em HTTPS; em HTTP, a notícia da entrada aparece num cartão no app.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:responsavel@empresa.com.br
# PUSH_FILE_PATH=
# Links da ficha e do relatório dos Experimentos ativos (cadastrados pelos admins na aba da Comunidade).
# EXPERIMENTOS_LINKS_PATH=
