(// No FunilExperimentos.tsx - board 2735 \(Epics\)) Tj
T* (totalExperimentos = allEpics.length) Tj
T* (cancelados = allEpics.filter\(e => e.status.id === '10015'\).length) Tj
T* (emAndamento = allEpics.filter\(e => e.status.id === '3'\).length) Tj
T* (emValidacao = allEpics.filter\(e => e.status.id === '10204'\).length) Tj
T* (concluidos = allEpics.filter\(e =>) Tj
T* (  e.status.id === '10003' || e.status.id === '10019'\).length) Tj
T* () Tj
T* (// Board 2734 \(Iniciativas\) - pipeline counts) Tj
T* (pilotos = pipeline['EM PILOTO']) Tj
T* (escala = pipeline['EM ESCALA']) Tj
T* () Tj
T* (// Taxas de conversao:) Tj
T* (taxaCancelamento = \(cancelados / total\) * 100) Tj
T* (taxaAndamento    = \(emAndamento / total\) * 100) Tj
T* (taxaValidacao    = \(emValidacao / emAndamento\) * 100) Tj
T* (taxaConclusao    = \(concluidos / emValidacao\) * 100) Tj
T* (taxaPiloto       = \(pilotos / concluidos\) * 100) Tj
T* (taxaEscala       = \(escala / pilotos\) * 100) Tj
