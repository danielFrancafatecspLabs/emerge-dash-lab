(// Algoritmo em mappers.ts \(buildDashboardData\)) Tj
T* (const metasAgregadas = {) Tj
T* (  EBITDA: {count:0, valor:0},) Tj
T* (  NPS: {count:0, valor:0},) Tj
T* (  Receita: {count:0, valor:0}) Tj
T* (}) Tj
T* () Tj
T* (for each Iniciativa:) Tj
T* (  seenMetas = set\(\)) Tj
T* (  for each Epic da Iniciativa:) Tj
T* (    meta = epic.metaCategoria) Tj
T* (    if meta AND meta NOT in seenMetas:) Tj
T* (      seenMetas.add\(meta\)) Tj
T* (      metasAgregadas[meta].count++) Tj
T* (      metasAgregadas[meta].valor +=) Tj
T* (        iniciativa.beneficioQuantitativoTotal) Tj
T* () Tj
T* (// Exibicao no ResumoExecutivo.tsx:) Tj
T* (totalMetasValor = EBITDA.valor + Receita.valor + NPS.valor) Tj
T* (pct = \(meta.valor / totalMetasValor\) * 100) Tj
ET
