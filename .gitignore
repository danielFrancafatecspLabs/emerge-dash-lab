data/community-profiles.json
data/community-messages.json
data/stories.json
# Fotos de perfil enviadas em Meu perfil
data/avatars/

# Saídas de scripts
public/comunidade/*
# Vídeos da Trilha de Experimentação (servidos em /comunidade/videos, acessíveis à role community)
!public/comunidade/videos/
.tmp/
.worktrees/

# Editores e sistema
.vscode/*
