# Dependências e build
node_modules/
.next/
out/
build/
dist/
next-env.d.ts.bak
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*

# Variáveis de ambiente (nunca versionar segredos)
.env
.env.*
!.env.example

# Caches gerados em tempo de execução
.portfolio-cache.json
.segmento-cache-v2.json
